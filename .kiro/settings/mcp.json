{
  "mcpServers": {
    "Quality Code Examples Knowledge Base": {
      "command": ".kiro/venv/bin/python3",
      "args": [
        ".kiro/rag_server.py",
        "--kb-path",
        ".kiro/knowledge_base",
        "--persist-dir",
        ".kiro/.vector_store",
        "--stdio"
      ],
      "env": {
        "PYTHONPATH": ".kiro",
        "FASTMCP_LOG_LEVEL": "INFO"
      },
      "disabled": false,
      "autoApprove": [
        "search",
        "knowledge_base_info"
      ]
    },
    "awslabs.bedrock-kb-retrieval-mcp-server": {
      "command": "uvx",
      "args": ["awslabs.bedrock-kb-retrieval-mcp-server@latest"],
      "env": {
        "AWS_PROFILE": "cex-ai-kb-access",
        "AWS_REGION": "us-west-2",
        "FASTMCP_LOG_LEVEL": "INFO",
        "BEDROCK_KB_RERANKING_ENABLED": "false"
      },
      "disabled": false,
      "autoApprove": []
    },
    "aws-knowledge-mcp-server": {
      "command": "uvx",
      "args": [
          "mcp-proxy",
          "--transport",
          "streamablehttp",
          "https://knowledge-mcp.global.api.aws"
        ]
    }
  }
}
